# LLM Keys (use at least one)
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database (auto-configured in Docker)
DATABASE_URL=postgresql://zkuser:zkpassword@localhost:5432/zkcredential

# Redis
REDIS_URL=redis://localhost:6379

# S3 / Storage
S3_BUCKET=zk-cred-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ZK / Blockchain
ZK_CIRCUIT_PATH=./circuits/build
VERIFIER_ADDRESS=0xAbCd...

# Security
ENCRYPTION_KEY=<32-byte hex, e.g. run: python -c "import secrets; print(secrets.token_hex(32))">
JWT_SECRET=<long random string>
